FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94
WORKDIR /app
COPY scripts/install-npm-toolchain.sh /tmp/install-npm-toolchain.sh
RUN sh /tmp/install-npm-toolchain.sh \
    && rm /tmp/install-npm-toolchain.sh \
    && npm cache clean --force \
    && rm -rf /opt/yarn-* \
    && rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3000
ENV PORT=3000

CMD ["npm", "run", "dev"]
